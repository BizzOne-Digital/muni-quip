# MongoDB Atlas connection string (database name included)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/muni-quip?retryWrites=true&w=majority

# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Public site URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://muni-quip.ca

# First admin account. Created automatically on the first successful login when no admin exists yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
